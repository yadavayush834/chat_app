{
  "name": "securechat",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "backend",
    "client"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w backend",
    "test": "npm test -w backend",
    "lint": "npm run lint -w client",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  }
}
